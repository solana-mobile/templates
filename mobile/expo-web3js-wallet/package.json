{
  "name": "expo-web3js-wallet",
  "displayName": "Expo Web3.js Wallet example",
  "description": "A wallet template for building a Solana mobile app with Expo, React Native, and Web3.js.",
  "usecase": "Mobile",
  "keywords": [
    "expo",
    "mobile-wallet-adapter",
    "react-native",
    "solana-web3js",
    "wallet",
    "wallet-ui"
  ],
  "create-solana-dapp": {
    "instructions": [
      "Build the Android app locally:",
      "+{pm} run android"
    ],
    "rename": {
      "Expo Web3js Wallet": {
        "paths": [
          "components"
        ],
        "to": "{{name}}"
      }
    },
    "skills": [
      "https://github.com/solana-foundation/solana-dev-skill",
      "https://github.com/solana-mobile/solana-mobile-dev-skill"
    ],
    "versions": {
      "adb": "33.0.0"
    }
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-snackbar"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "scripts": {
    "android": "expo run:android",
    "android:build": "expo prebuild -p android",
    "build": "tsc --noEmit && npm run android:build",
    "ci": "tsc --noEmit && npm run lint:check && npm run format:check && npm run android:build",
    "dev": "expo start",
    "doctor": "npx -y expo-doctor@latest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios": "expo run:ios",
    "lint": "expo lint --fix",
    "lint:check": "expo lint",
    "start": "expo start",
    "web": "expo start --web"
  },
  "main": "./index.js",
  "version": "1.0.0",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.5",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.2",
    "@rn-primitives/dropdown-menu": "^1.2.0",
    "@rn-primitives/portal": "^1.3.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.85.5",
    "@wallet-ui/react-native-web3js": "^4.2.1",
    "color": "^4.2.3",
    "expo": "~57.0.6",
    "expo-blur": "~57.0.2",
    "expo-dev-client": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.6",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "js-base64": "^3.7.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.6",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-snackbar": "^2.9.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.1",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "react-qr-code": "2.0.18"
  },
  "devDependencies": {
    "@types/color": "^4.2.1",
    "@types/react": "~19.2.14",
    "eslint": "^9.33.0",
    "eslint-config-expo": "~57.0.0",
    "prettier": "^3.7.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
